# Render 배포용 환경 변수 (JSON 워크플로우)

# OpenAI API 키 (Render 대시보드에서 설정)
OPENAI_API_KEY=your-openai-api-key

# Langflow 워크플로우 설정
LANGFLOW_WORKFLOW_PATH=workflow.json

# 포트 설정 (Render에서 자동 설정됨)
PORT=$PORT

# 데이터베이스 설정 (선택사항)
# DATABASE_URL=sqlite:///./data/langflow.db

# 보안 설정 (선택사항)
# SECRET_KEY=your-secret-key-here 